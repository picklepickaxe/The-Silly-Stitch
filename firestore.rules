rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isRealUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isRealUser() && request.auth.uid == uid;
    }

    function validOrderCreate() {
      let data = request.resource.data;
      return
        data.keys().hasOnly([
          'orderId',
          'userId',
          'customerName',
          'email',
          'phone',
          'items',
          'total',
          'status',
          'whatsappConfirmed',
          'createdAt'
        ]) &&
        data.orderId is string && data.orderId.size() > 0 && data.orderId.size() < 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() < 256 &&
        data.phone is string && data.phone.matches('^[0-9]{10}$') &&
        data.total is number && data.total > 0 && data.total < 1000000 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.status == "pending" &&
        data.whatsappConfirmed == false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isRealUser() && validOrderCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) &&
        request.resource.data.successfulReferralCount == 0 &&
        request.resource.data.rewardsAvailable == 0 &&
        request.resource.data.referralSignupDiscountUsed == false &&
        request.resource.data.referralCode is string;

      allow update: if isAdmin() ||
        (isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));

      allow delete: if false;
    }

    match /referralCodes/{code} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}